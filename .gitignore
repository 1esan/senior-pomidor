# Local data stays local. New file types require explicit review.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/GIT_WORKFLOW.md
!/THIRD_PARTY.md
!/*.py
!/*.command
!/*.css
!/setup.html
!/hh-dash-template.html
!/requirements-lock.txt
!/interview_settings.json
!/tests/
!/static/
!/vendor/
!/tools/
!/.githooks/
!/.github/
# Sensitive state, environments, generated reports and personal configuration
.state/
.browsers/
.venv/
logs/
schedule/
__pycache__/
*.py[cod]
*.session*
*.sqlite*
*.db*
*.log
.env*
*.pem
*.key
*.p12
.DS_Store
**/auth.json
**/cookies*.json
**/token*.json
**/*secret*.json
/vendor/**/config/*
/vendor/**/docs/hhapi/
/vendor/**/.git/
/tests/test_screening_profile.py
